{
    "name": "3dsim",


    "objects": [
        { "name": "env_tex", "components": { "Texture": { "path": "fly-studio-03_1K.exr" } } },
        { "name": "env", "components": { "Environment": { "intensity": 0.1, "tex": "env_tex" } } },
        {
            "name": "cam",
            "components": {
                "Transform": { "pos": [0, 9, 14], "quat": [-0.201066, 0, 0, 0.979578] },
                "Camera": { "fovDeg": 50, "active": true }
            },
            "script": "scenes/camera"
        },
        { "name": "grabberShape", "components": { "SphereShape": { "radius": 0.4 } } },
        { 
            "name": "grabberCol",   
            "components": { 
                "Collider": { "shape": "grabberShape" } 
            } 
        },
        {
            "name": "key light grabber",
            "components": {
                "Transform": { "pos": [0, 2, 0] },
                "KinematicBody": { "colliders": [ "grabberCol" ] }
            }
        },
        {
            "name": "key light",
            "components": {
                "Transform": { "pos": [0, 0, 0] },
                "PointLight": { "color": [1, 0.95, 0.9], "intensity": 2, "radius": 0.15 },
                "Parent": { "e": "key light grabber" }
            }
        },
        {
            "name": "tetrahedron",
            "components": {
                "Geometry": {
                    "pos": [ 0.0866, 0.0866, 0.0866,  0.0866, -0.0866, -0.0866,
                           -0.0866, 0.0866, -0.0866,  -0.0866, -0.0866, 0.0866 ],
                    "nrm": [ 0.5774, 0.5774, 0.5774,  0.5774, -0.5774, -0.5774,
                           -0.5774, 0.5774, -0.5774,  -0.5774, -0.5774, 0.5774 ],
                    "idx": [ 0, 1, 2,  0, 3, 1,  0, 2, 3,  1, 3, 2 ]
                }
            }
        },
        { "name": "mat_tetra", "components": { "Material": { "baseColor": [0, 0, 0], "emissive": [10, 9.5, 9] } } },
        {
            "name": "tetra",
            "components": {
                "Transform": { "pos": [0, 0, 0] },
                "Renderable": { "geom": "tetrahedron", "noShadow": true },
                "MaterialRef": { "material": "mat_tetra" },
                "Parent": { "e": "key light grabber" }
            }
        },
        { "name": "mat_tetra2", "components": { "Material": { "baseColor": [0, 0, 0], "emissive": [4, 6, 10] } } },
        {
            "name": "rim light grabber",
            "components": {
                "Transform": { "pos": [-9, 6, -7] },
                "KinematicBody": { "colliders": [ "grabberCol" ] }
            }
        },
        {
            "name": "tetra2",
            "components": {
                "Transform": { "pos": [0, 0, 0] },
                "Renderable": { "geom": "tetrahedron", "noShadow": true },
                "MaterialRef": { "material": "mat_tetra2" },
                "Parent": { "e": "rim light grabber" }
            }
        },
        {
            "name": "rim light",
            "components": {
                "Transform": { "pos": [0, 0, 0] },
                "PointLight": { "color": [0.4, 0.6, 1], "intensity": 60, "radius": 0.5 },
                "Parent": { "e": "rim light grabber" }
            }
        },
        { "name": "mat_ground", "components": { "Material": { "baseColor": [0.19, 0.21, 0.17], "roughness": 0.85 } } },
        {
            "name": "mat_capsule",
            "components": { "Material": { "baseColor": [0.85, 0.35, 0.3], "metallic": 0.9, "roughness": 0.25 } }
        },
        { "name": "tex_cloth", "components": { "Texture": { "path": "cloth_albedo.png" } } },
        {
            "name": "mat_cloth",
            "components": { "Material": { "baseColor": [1, 1, 1], "roughness": 0.8, "tex": "tex_cloth" } }
        },
        { "name": "mat_ball", "components": { "Material": { "baseColor": [0.22, 0.62, 0.6], "roughness": 0.4 } } },
        { "name": "demo", "script": "scenes/demo" },
        { "name": "vr", "script": "scenes/vr_controller" }
    ],
    "ui": {
        "title": "3dsim",
        "size": [320, 800],
        "widgets": [
            { "type": "color", "label": "background", "bind": "settings.RenderSettings.bgColor" },
            { "type": "text", "label": "sim: GPU (cloth + ball)" },
            {
                "type": "section",
                "label": "cloth",
                "children": [
                    { "type": "slider-f", "label": "mass", "bind": "cloth.SoftBodyData.mass" },
                    { "type": "slider-f", "label": "damping", "bind": "cloth.SoftBodyData.damping", "fmt": "%.3f" },
                    { "type": "slider-i", "label": "passes", "bind": "cloth.SoftBodyData.passes" },
                    { "type": "slider-f", "label": "stiffness", "bind": "cloth.SoftBodyData.stiffness" },
                    { "type": "slider-f", "label": "tension", "bind": "cloth.SoftBodyData.tension" },
                    { "type": "slider-f", "label": "friction", "bind": "cloth.SoftBodyData.friction" },
                    { "type": "slider-i", "label": "steps", "bind": "cloth.SoftBodyData.steps" }
                ]
            },
            {
                "type": "section",
                "label": "ball",
                "children": [
                    { "type": "slider-f", "label": "mass", "bind": "ball.SoftBodyData.mass" },
                    { "type": "slider-f", "label": "damping", "bind": "ball.SoftBodyData.damping", "fmt": "%.3f" },
                    { "type": "slider-i", "label": "passes", "bind": "ball.SoftBodyData.passes" },
                    { "type": "slider-f", "label": "stiffness", "bind": "ball.SoftBodyData.stiffness" },
                    { "type": "slider-f", "label": "tension", "bind": "ball.SoftBodyData.tension" },
                    { "type": "slider-f", "label": "friction", "bind": "ball.SoftBodyData.friction" },
                    { "type": "slider-i", "label": "steps", "bind": "ball.SoftBodyData.steps" }
                ]
            },
            {
                "type": "section",
                "label": "jolt iterations",
                "collapsible": false,
                "children": [
                    { "type": "slider-i", "label": "velocity", "bind": "settings.PhysicsSettings.velocitySteps" }
                ]
            },
            {
                "type": "section",
                "label": "camera",
                "collapsible": false,
                "children": [
                    { "type": "slider-f", "label": "fov", "bind": "cam.Camera.fovDeg", "fmt": "%.0f" },
                    { "type": "slider-f", "label": "near", "bind": "cam.Camera.nearP", "fmt": "%.3f" },
                    { "type": "slider-f", "label": "far", "bind": "cam.Camera.farP", "fmt": "%.0f" }
                ]
            },
            {
                "type": "section",
                "label": "tone",
                "children": [
                    { "type": "slider-f", "label": "exposure", "bind": "settings.RenderSettings.exposure" },
                    { "type": "slider-f", "label": "hdri intensity", "bind": "env.Environment.intensity" }
                ]
            },
            {
                "type": "section",
                "label": "lights",
                "collapsible": false,
                "children": [
                    {
                        "type": "section",
                        "label": "key light",
                        "children": [
                            { "type": "slider-f", "label": "on", "bind": "key light.PointLight.on", "lo": 0, "hi": 1, "fmt": "%.0f" },
                            { "type": "drag-v3", "label": "pos", "bind": "key light.Transform.pos" },
                            { "type": "color", "label": "color", "bind": "key light.PointLight.color" },
                            { "type": "slider-f", "label": "intensity", "bind": "key light.PointLight.intensity", "lo": 0, "hi": 1000, "fmt": "%.0f" },
                            { "type": "slider-f", "label": "radius", "bind": "key light.PointLight.radius" },
                            {
                                "type": "section",
                                "label": "shadow bias",
                                "children": [
                                    { "type": "slider-f", "label": "normal", "bind": "key light.PointLight.shadowNormalBias" },
                                    { "type": "slider-f", "label": "base", "bind": "key light.PointLight.shadowBiasBase" },
                                    { "type": "slider-f", "label": "slope", "bind": "key light.PointLight.shadowBiasSlope" },
                                    { "type": "slider-f", "label": "search", "bind": "key light.PointLight.shadowSearchScale" },
                                    { "type": "slider-f", "label": "max radius", "bind": "key light.PointLight.shadowMaxRadius", "fmt": "%.1f" }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "section",
                        "label": "rim light",
                        "children": [
                            { "type": "slider-f", "label": "on", "bind": "rim light.PointLight.on", "lo": 0, "hi": 1, "fmt": "%.0f" },
                            { "type": "drag-v3", "label": "pos", "bind": "rim light.Transform.pos" },
                            { "type": "color", "label": "color", "bind": "rim light.PointLight.color" },
                            { "type": "slider-f", "label": "intensity", "bind": "rim light.PointLight.intensity", "lo": 0, "hi": 1000, "fmt": "%.0f" },
                            { "type": "slider-f", "label": "radius", "bind": "rim light.PointLight.radius" }
                        ]
                    }
                ]
            },
            {
                "type": "section",
                "label": "materials",
                "collapsible": false,
                "children": [
                    {
                        "type": "section",
                        "label": "ground",
                        "children": [
                            { "type": "color", "label": "base color", "bind": "mat_ground.Material.baseColor" },
                            { "type": "slider-f", "label": "metallic", "bind": "mat_ground.Material.metallic" },
                            { "type": "slider-f", "label": "roughness", "bind": "mat_ground.Material.roughness" }
                        ]
                    },
                    {
                        "type": "section",
                        "label": "capsule",
                        "children": [
                            { "type": "color", "label": "base color", "bind": "mat_capsule.Material.baseColor" },
                            { "type": "slider-f", "label": "metallic", "bind": "mat_capsule.Material.metallic" },
                            { "type": "slider-f", "label": "roughness", "bind": "mat_capsule.Material.roughness" }
                        ]
                    },
                    {
                        "type": "section",
                        "label": "cloth",
                        "children": [
                            { "type": "color", "label": "base color", "bind": "mat_cloth.Material.baseColor" },
                            { "type": "slider-f", "label": "metallic", "bind": "mat_cloth.Material.metallic" },
                            { "type": "slider-f", "label": "roughness", "bind": "mat_cloth.Material.roughness" }
                        ]
                    },
                    {
                        "type": "section",
                        "label": "ball",
                        "children": [
                            { "type": "color", "label": "base color", "bind": "mat_ball.Material.baseColor" },
                            { "type": "slider-f", "label": "metallic", "bind": "mat_ball.Material.metallic" },
                            { "type": "slider-f", "label": "roughness", "bind": "mat_ball.Material.roughness" }
                        ]
                    }
                ]
            },
            { "type": "button", "label": "reset params", "action": "demo.LuaScript.reset_params" },
            { "type": "button", "label": "demo window", "action": "demo-window" }
        ]
    }
}
