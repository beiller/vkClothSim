{
    "name": "shadow test",


    "objects": [
        { "name": "env_tex", "components": { "Texture": { "path": "fly-studio-03_1K.exr" } } },
        { "name": "env", "components": { "Environment": { "intensity": 0.0, "tex": "env_tex" } } },
        {
            "name": "cam",
            "components": {
                "Transform": { "pos": [0, 4, 11], "quat": [-0.088866, 0, 0, 0.996047] },
                "Camera": { "fovDeg": 50, "active": true }
            },
            "script": "scenes/camera"
        },
        {
            "name": "key light",
            "components": {
                "Transform": { "pos": [0, 7, 0] },
                "PointLight": { "color": [1.0, 0.97, 0.92], "intensity": 300, "radius": 0.5 }
            }
        },
        { "name": "white", "components": { "Material": { "baseColor": [1, 1, 1], "roughness": 0.9 } } },
        { "name": "tex_plaid", "components": { "Texture": { "path": "cloth_albedo.png" } } },
        {
            "name": "plaid",
            "components": { "Material": { "baseColor": [1, 1, 1], "roughness": 0.35, "tex": "tex_plaid" } }
        },
        { "name": "shadow", "script": "scenes/shadow" },
        { "name": "vr", "script": "scenes/vr_controller" }
    ],
    "set": {
        "plaid.Material.roughness": 0.35
    },
    "ui": {
        "title": "shadow test",
        "size": [320, 800],
        "widgets": [
            {
                "type": "section",
                "label": "camera",
                "children": [
                    { "type": "slider-f", "label": "fov", "bind": "cam.Camera.fovDeg", "fmt": "%.0f" }
                ]
            },
            {
                "type": "section",
                "label": "tone",
                "children": [
                    { "type": "slider-f", "label": "exposure", "bind": "settings.RenderSettings.exposure" },
                    { "type": "slider-f", "label": "hdri intensity", "bind": "env.Environment.intensity" }
                ]
            },
            {
                "type": "section",
                "label": "key light",
                "children": [
                    { "type": "drag-v3", "label": "pos", "bind": "key light.Transform.pos" },
                    { "type": "color", "label": "color", "bind": "key light.PointLight.color" },
                    { "type": "slider-f", "label": "intensity", "bind": "key light.PointLight.intensity", "lo": 0, "hi": 1000, "fmt": "%.0f" },
                    { "type": "slider-f", "label": "radius", "bind": "key light.PointLight.radius" },
                    {
                        "type": "section",
                        "label": "shadow bias",
                        "children": [
                            { "type": "slider-f", "label": "normal", "bind": "key light.PointLight.shadowNormalBias" },
                            { "type": "slider-f", "label": "base", "bind": "key light.PointLight.shadowBiasBase" },
                            { "type": "slider-f", "label": "slope", "bind": "key light.PointLight.shadowBiasSlope" },
                            { "type": "slider-f", "label": "search", "bind": "key light.PointLight.shadowSearchScale" },
                            { "type": "slider-f", "label": "max radius", "bind": "key light.PointLight.shadowMaxRadius", "fmt": "%.1f" }
                        ]
                    }
                ]
            },
            {
                "type": "section",
                "label": "materials",
                "children": [
                    { "type": "color", "label": "ground color", "bind": "white.Material.baseColor" },
                    { "type": "slider-f", "label": "ground roughness", "bind": "white.Material.roughness" },
                    { "type": "color", "label": "ball color", "bind": "plaid.Material.baseColor" },
                    { "type": "slider-f", "label": "ball roughness", "bind": "plaid.Material.roughness" }
                ]
            }
        ]
    }
}
