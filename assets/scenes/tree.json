{
    "name": "hierarchy",


    "objects": [
        { "name": "env_tex", "components": { "Texture": { "path": "fly-studio-03_1K.exr" } } },
        { "name": "env", "components": { "Environment": { "intensity": 0.0, "tex": "env_tex" } } },
        {
            "name": "cam",
            "components": {
                "Transform": { "pos": [0, 4.5, 15], "quat": [-0.049814, 0, 0, 0.998759] },
                "Camera": { "fovDeg": 50, "active": true }
            },
            "script": "scenes/camera"
        },
        {
            "name": "sun",
            "components": {
                "Transform": { "pos": [7, 12, 5] },
                "PointLight": { "color": [1, 0.97, 0.92], "intensity": 200, "radius": 0.6 }
            }
        },
        { "name": "mat_ground", "components": { "Material": { "baseColor": [0.16, 0.2, 0.14], "roughness": 0.9 } } },
        { "name": "tree", "script": "scenes/tree" },
        { "name": "vr", "script": "scenes/vr_controller" }
    ],
    "ui": {
        "title": "hierarchy",
        "size": [340, 400],
        "widgets": [
            { "type": "text", "label": "fractal tree, depth 0-5 (trunk -> canopy)" },
            { "type": "text", "label": "each generation bends outward; capsules taper and" },
            { "type": "text", "label": "point along their branch; sways in a sin-wave breeze" },
            {
                "type": "section",
                "label": "tone",
                "children": [
                    { "type": "slider-f", "label": "exposure", "bind": "render.exposure" },
                    { "type": "slider-f", "label": "hdri intensity", "bind": "env.Environment.intensity" }
                ]
            },
            {
                "type": "section",
                "label": "sun",
                "children": [
                    { "type": "slider-f", "label": "on", "bind": "sun.PointLight.on", "lo": 0, "hi": 1, "fmt": "%.0f" },
                    { "type": "drag-v3", "label": "pos", "bind": "sun.Transform.pos" },
                    { "type": "color", "label": "color", "bind": "sun.PointLight.color" },
                    { "type": "slider-f", "label": "intensity", "bind": "sun.PointLight.intensity", "lo": 0, "hi": 1000, "fmt": "%.0f" },
                    { "type": "slider-f", "label": "radius", "bind": "sun.PointLight.radius" },
                    {
                        "type": "section",
                        "label": "shadow bias",
                        "children": [
                            { "type": "slider-f", "label": "normal", "bind": "sun.PointLight.shadowNormalBias" },
                            { "type": "slider-f", "label": "base", "bind": "sun.PointLight.shadowBiasBase" },
                            { "type": "slider-f", "label": "slope", "bind": "sun.PointLight.shadowBiasSlope" },
                            { "type": "slider-f", "label": "search", "bind": "sun.PointLight.shadowSearchScale" },
                            { "type": "slider-f", "label": "max radius", "bind": "sun.PointLight.shadowMaxRadius", "fmt": "%.1f" }
                        ]
                    }
                ]
            }
        ]
    }
}
