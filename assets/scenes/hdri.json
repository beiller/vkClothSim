{
    "name": "hdri",
    "env": "fly-studio-03_1K.exr",
    "envIntensity": 1.0,
    "objects": [
        {
            "name": "cam",
            "components": {
                "Transform": { "pos": [0, 0, 6], "quat": [0, 0, 0, 1] },
                "Camera": { "fovDeg": 50, "active": true }
            },
            "script": "scenes/camera"
        },
        {
            "name": "light",
            "components": {
                "Transform": { "pos": [2, 2, 3] },
                "PointLight": { "color": [1, 1, 1], "intensity": 20, "radius": 0.15 }
            }
        },
        {
            "name": "mat_sphere",
            "components": { "Material": { "baseColor": [0.25, 0.25, 0.25], "roughness": 1.0 } }
        },
        { "name": "hdri", "script": "scenes/hdri" },
        { "name": "vr", "script": "scenes/vr_controller" }
    ],
    "ui": {
        "title": "hdri",
        "size": [320, 680],
        "widgets": [
            { "type": "color", "label": "base color", "bind": "mat_sphere.Material.baseColor" },
            { "type": "slider-f", "label": "metallic", "bind": "mat_sphere.Material.metallic" },
            { "type": "slider-f", "label": "roughness", "bind": "mat_sphere.Material.roughness" },
            {
                "type": "section",
                "label": "camera",
                "collapsible": false,
                "children": [
                    { "type": "slider-f", "label": "fov", "bind": "cam.Camera.fovDeg", "fmt": "%.0f" }
                ]
            },
            {
                "type": "section",
                "label": "tone",
                "children": [
                    { "type": "slider-f", "label": "exposure", "bind": "render.exposure" },
                    { "type": "slider-f", "label": "hdri intensity", "bind": "render.envIntensity" }
                ]
            },
            {
                "type": "section",
                "label": "light",
                "children": [
                    { "type": "slider-f", "label": "on", "bind": "light.PointLight.on", "lo": 0, "hi": 1, "fmt": "%.0f" },
                    { "type": "drag-v3", "label": "pos", "bind": "light.Transform.pos" },
                    { "type": "color", "label": "color", "bind": "light.PointLight.color" },
                    { "type": "slider-f", "label": "intensity", "bind": "light.PointLight.intensity", "lo": 0, "hi": 1000, "fmt": "%.0f" },
                    { "type": "slider-f", "label": "radius", "bind": "light.PointLight.radius" }
                ]
            }
        ]
    }
}
