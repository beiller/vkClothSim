{
    "name": "base test",
    "env": "fly-studio-03_1K.exr",
    "envIntensity": 0.15,
    "objects": [
        {
            "name": "cam",
            "components": {
                "Transform": { "pos": [0, 1.0, 2.5], "quat": [-0.0785, 0, 0, 0.9969] },
                "Camera": { "fovDeg": 50, "active": true }
            },
            "script": "scenes/camera"
        },
        {
            "name": "key light",
            "components": {
                "Transform": { "pos": [-2, 2, 2.5] },
                "PointLight": { "color": [1, 0.95, 0.9], "intensity": 30, "radius": 0.5 }
            }
        },
        { "name": "ground" },
        { "name": "char" },
        { "name": "probe", "script": "scenes/base_test" },
        { "name": "vr", "script": "scenes/vr_controller" }
    ],
    "ui": {
        "title": "glass",
        "size": [320, 560],
        "widgets": [
            {
                "type": "section",
                "label": "Mats",
                "children": [
                    { "type": "slider-f", "label": "basegen8/Cornea.Material.refraction", "bind": "basegen8/Cornea.Material.refraction" },
                    { "type": "slider-f", "label": "basegen8/Cornea.Material.ior", "bind": "basegen8/Cornea.Material.ior" },
                    { "type": "slider-f", "label": "basegen8/Cornea.Material.roughness", "bind": "basegen8/Cornea.Material.roughness" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.Material.refraction", "bind": "basegen8/EyeMoisture.Material.refraction" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.Material.ior", "bind": "basegen8/EyeMoisture.Material.ior" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.Material.roughness", "bind": "basegen8/EyeMoisture.Material.roughness" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.1.Material.refraction", "bind": "basegen8/EyeMoisture.1.Material.refraction" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.1.Material.ior", "bind": "basegen8/EyeMoisture.1.Material.ior" },
                    { "type": "slider-f", "label": "basegen8/EyeMoisture.1.Material.roughness", "bind": "basegen8/EyeMoisture.1.Material.roughness" },
                    { "type": "slider-f", "label": "basegen8/Face.Material.ssssWeight", "bind": "basegen8/Face.Material.ssssWeight" },
                    { "type": "slider-f", "label": "key light.PointLight.radius", "bind": "key light.PointLight.radius" }
                ]
            },
            {
                "type": "section",
                "label": "tone",
                "children": [
                    { "type": "slider-f", "label": "exposure", "bind": "render.exposure" },
                    { "type": "slider-f", "label": "hdri intensity", "bind": "render.envIntensity" }
                ]
            }
