#version 450
layout(local_size_x = 64) in;

struct Vtx { vec3 pos; vec3 nrm; vec3 col; };
layout(binding = 0) buffer Vtxs { Vtx v[]; } vtxs;
layout(binding = 1) buffer Prev { vec3 v[]; } prevB;

struct Capsule { vec4 centerRadius; vec4 quat; vec4 halfLen; };
layout(binding = 2) buffer Capsules { Capsule cs[]; } caps;

struct Entry { int j; float rest; float k; int pad; };
layout(binding = 3) buffer Entries { Entry e[]; } ents;
layout(binding = 4) buffer EntryStart { int s[]; } estart;
layout(binding = 5) buffer ColorVerts { int v[]; } colorVerts;

layout(binding = 6) buffer PhysP {
    int nCaps;
    float dt;
    float damping;
    float gravity;
    float friction;
    float skin;
    float fricMargin;
    float tension;
    float stiff;
    float maxStep;
} ph;

layout(binding = 7) buffer Sub0 { vec3 v[]; } sub0;
layout(binding = 8) buffer ContactN { vec4 n[]; } contactN;
layout(binding = 9) buffer ContactL { float l[]; } contactL;

layout(push_constant) uniform PC { int mode; int n; int groupOffset; int pinned; } pc;

vec3 rpos(int i) { return vtxs.v[i].pos; }
void wpos(int i, vec3 x) { vtxs.v[i].pos = x; }
void wnrm(int i, vec3 x) { vtxs.v[i].nrm = x; }

mat3 quatMat(vec4 q) {
    q = normalize(q);
    float x = q.x, y = q.y, z = q.z, w = q.w;
    return mat3(
        vec3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + z * w), 2.0 * (x * z - y * w)),
        vec3(2.0 * (x * y - z * w), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + x * w)),
        vec3(2.0 * (x * z + y * w), 2.0 * (y * z - x * w), 1.0 - 2.0 * (x * x + y * y)));
}

const float COLLIDE_COMPLIANCE = 0.02;
const float FRICTION_COMPLIANCE = 0.0;
const float MIN_CONSTRAINT_ALPHA = 10.0;
float constraintAlpha() {
    float a = (ph.stiff > 1e-3) ? 10.0 / ph.stiff : 1e3;
    return max(a, MIN_CONSTRAINT_ALPHA);
}

vec3 collideVertex(int i, vec3 P) {
    vec3 cN = contactN.n[i].xyz;
    float cL = contactL.l[i];
    for (int c = 0; c < ph.nCaps; ++c) {
        vec3 center = caps.cs[c].centerRadius.xyz;
        float radius = caps.cs[c].centerRadius.w;
        vec3 axis = quatMat(caps.cs[c].quat) * vec3(0.0, caps.cs[c].halfLen.x, 0.0);
        vec3 A = center - axis, B = center + axis;
        vec3 AB = B - A;
        float t = clamp(dot(P - A, AB) / max(dot(AB, AB), 1e-6), 0.0, 1.0);
        vec3 Q = A + AB * t;
        vec3 d = P - Q;
        float dist = length(d);
        float C = dist - (radius + ph.skin);
        if (C < 0.0) {
            vec3 n = dist > 1e-5 ? d / dist : vec3(0.0, 1.0, 0.0);
            float corr = -C / (1.0 + COLLIDE_COMPLIANCE);
            P += n * corr;
            cN += n * corr;
            cL += corr;
        }
    }
    if (P.y < 0.0) {
        float corr = -P.y / (1.0 + COLLIDE_COMPLIANCE);
        P.y += corr;
        cN.y += corr;
        cL += corr;
    }
    float nl = length(cN);
    if (nl > 1e-8) {
        vec3 fn = cN / nl;
        vec3 rel = P - sub0.v[i];
        vec3 vt = rel - fn * dot(rel, fn);
        float lv = length(vt);
        float limit = ph.friction * cL;
        if (lv > 1e-8 && limit > 0.0) {
            float corr = min(lv, limit) / (1.0 + FRICTION_COMPLIANCE);
            P -= vt * (corr / lv);
        }
    }
    contactN.n[i] = vec4(cN, 0.0);
    contactL.l[i] = cL;
    return P;
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    if (pc.pinned == 1) return;
    int vi = (pc.mode == 1) ? colorVerts.v[pc.groupOffset + i] : i;

    if (pc.mode == 0) {
        vec3 P = rpos(vi);
        vec3 Pr = prevB.v[vi];
        vec3 d = (P - Pr) * ph.damping + vec3(0.0, ph.gravity, 0.0) * (ph.dt * ph.dt);
        float dl = length(d);
        if (dl > ph.maxStep)
            d *= ph.maxStep / dl;
        wpos(vi, P + d);
    } else if (pc.mode == 1) {
        vec3 P = collideVertex(vi, rpos(vi));
        float alpha = constraintAlpha();
        for (int e = estart.s[vi]; e < estart.s[vi + 1]; ++e) {
            Entry en = ents.e[e];
            vec3 d = rpos(en.j) - P;
            float dist = length(d);
            if (dist < 1e-6) continue;
            float rest = en.rest * ph.tension;
            P += d * ((dist - rest) / dist * (en.k / (2.0 + alpha)));
        }
        wpos(vi, P);
    } else if (pc.mode == 2) {
        wpos(vi, collideVertex(vi, rpos(vi)));
    } else if (pc.mode == 3) {
        int s0 = estart.s[vi], s1 = estart.s[vi + 1];
        if (s1 - s0 >= 2) {
            vec3 P = rpos(vi);
            vec3 e1 = rpos(ents.e[s0].j) - P;
            vec3 e2 = rpos(ents.e[s0 + 1].j) - P;
            vec3 n = cross(e1, e2);
            float l = length(n);
            wnrm(vi, l > 1e-6 ? n / l : vec3(0.0, 1.0, 0.0));
        }
    } else if (pc.mode == 4) {
        sub0.v[vi] = rpos(vi);
        contactN.n[vi] = vec4(0.0);
        contactL.l[vi] = 0.0;
    } else if (pc.mode == 5) {
        vec3 P = rpos(vi);
        vec3 v = (P - sub0.v[vi]) / ph.dt;
        float nl = length(contactN.n[vi].xyz);
        if (nl > 1e-8) {
            vec3 fn = contactN.n[vi].xyz / nl;
            float vn = dot(v, fn);
            if (vn < 0.0)
                v -= fn * vn;
        }
        prevB.v[vi] = P - v * ph.dt;
    }
}
