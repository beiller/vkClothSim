#version 450
layout(local_size_x = 64) in;

layout(binding = 0) buffer PosB { float p[]; } posB;
layout(binding = 1) buffer NrmB { float p[]; } nrmB;
layout(binding = 2) buffer Prev { float v[]; } prevB;

struct Capsule { vec4 centerRadius; vec4 quat; vec4 halfLen; };
layout(binding = 3) buffer Capsules { Capsule cs[]; } caps;

struct Entry { int j; float rest; float k; int pad; };
layout(binding = 4) buffer Entries { Entry e[]; } ents;
layout(binding = 5) buffer EntryStart { int s[]; } estart;
layout(binding = 6) buffer ColorVerts { int v[]; } colorVerts;

layout(binding = 7) buffer PhysP {
    int nCaps;
    float dt;
    float damping;
    float gravity;
    float friction;
    float skin;
    float tension;
    float stiff;
    float maxStep;
} ph;

layout(binding = 8) buffer Sub0 { float v[]; } sub0;
layout(binding = 9) buffer ContactN { vec4 n[]; } contactN;
layout(binding = 10) buffer ContactL { float l[]; } contactL;
layout(binding = 11) buffer Tris { uint t[]; } tris;
layout(binding = 12) buffer TriStart { int s[]; } triStart;
layout(binding = 13) buffer TriList { int l[]; } triList;

layout(push_constant) uniform PC { int mode; int n; int groupOffset; int pad; } pc;

vec3 rpos(int i) {
    int o = i * 3;
    return vec3(posB.p[o], posB.p[o + 1], posB.p[o + 2]);
}
vec3 rprev(int i) {
    int o = i * 3;
    return vec3(prevB.v[o], prevB.v[o + 1], prevB.v[o + 2]);
}
vec3 rsub0(int i) {
    int o = i * 3;
    return vec3(sub0.v[o], sub0.v[o + 1], sub0.v[o + 2]);
}
void wpos(int i, vec3 x) {
    int o = i * 3;
    posB.p[o] = x.x;
    posB.p[o + 1] = x.y;
    posB.p[o + 2] = x.z;
}
void wprev(int i, vec3 x) {
    int o = i * 3;
    prevB.v[o] = x.x;
    prevB.v[o + 1] = x.y;
    prevB.v[o + 2] = x.z;
}
void wsub0(int i, vec3 x) {
    int o = i * 3;
    sub0.v[o] = x.x;
    sub0.v[o + 1] = x.y;
    sub0.v[o + 2] = x.z;
}
void wnrm(int i, vec3 x) {
    int o = i * 3;
    nrmB.p[o] = x.x;
    nrmB.p[o + 1] = x.y;
    nrmB.p[o + 2] = x.z;
}
vec3 rnrm(int i) {
    int o = i * 3;
    return vec3(nrmB.p[o], nrmB.p[o + 1], nrmB.p[o + 2]);
}

mat3 quatMat(vec4 q) {
    q = normalize(q);
    float x = q.x, y = q.y, z = q.z, w = q.w;
    return mat3(
        vec3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + z * w), 2.0 * (x * z - y * w)),
        vec3(2.0 * (x * y - z * w), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + x * w)),
        vec3(2.0 * (x * z + y * w), 2.0 * (y * z - x * w), 1.0 - 2.0 * (x * x + y * y)));
}

const float COLLIDE_COMPLIANCE = 0.02;
const float FRICTION_COMPLIANCE = 0.0;
const float MIN_CONSTRAINT_ALPHA = 10.0;
float constraintAlpha() {
    float a = (ph.stiff > 1e-3) ? 10.0 / ph.stiff : 1e3;
    return max(a, MIN_CONSTRAINT_ALPHA);
}

vec3 collideVertex(int i, vec3 P) {
    vec3 cN = contactN.n[i].xyz;
    float cL = contactL.l[i];
    for (int c = 0; c < ph.nCaps; ++c) {
        vec3 center = caps.cs[c].centerRadius.xyz;
        float radius = caps.cs[c].centerRadius.w;
        vec3 axis = quatMat(caps.cs[c].quat) * vec3(0.0, caps.cs[c].halfLen.x, 0.0);
        vec3 A = center - axis, B = center + axis;
        vec3 AB = B - A;
        float t = clamp(dot(P - A, AB) / max(dot(AB, AB), 1e-6), 0.0, 1.0);
        vec3 Q = A + AB * t;
        vec3 d = P - Q;
        float dist = length(d);
        float C = dist - (radius + ph.skin);
        if (C < 0.0) {
            vec3 n = dist > 1e-5 ? d / dist : vec3(0.0, 1.0, 0.0);
            float corr = -C / (1.0 + COLLIDE_COMPLIANCE);
            P += n * corr;
            cN += n * corr;
            cL += corr;
        }
    }
    if (P.y < 0.0) {
        float corr = -P.y / (1.0 + COLLIDE_COMPLIANCE);
        P.y += corr;
        cN.y += corr;
        cL += corr;
    }
    float nl = length(cN);
    if (nl > 1e-8) {
        vec3 fn = cN / nl;
        vec3 rel = P - rsub0(i);
        vec3 vt = rel - fn * dot(rel, fn);
        float lv = length(vt);
        float limit = ph.friction * cL;
        if (lv > 1e-8 && limit > 0.0) {
            float corr = min(lv, limit) / (1.0 + FRICTION_COMPLIANCE);
            P -= vt * (corr / lv);
        }
    }
    contactN.n[i] = vec4(cN, 0.0);
    contactL.l[i] = cL;
    return P;
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    int vi = (pc.mode == 1) ? colorVerts.v[pc.groupOffset + i] : i;

    if (pc.mode == 0) {
        vec3 P = rpos(vi);
        vec3 Pr = rprev(vi);
        vec3 d = (P - Pr) * ph.damping + vec3(0.0, ph.gravity, 0.0) * (ph.dt * ph.dt);
        float dl = length(d);
        if (dl > ph.maxStep)
            d *= ph.maxStep / dl;
        wpos(vi, P + d);
    } else if (pc.mode == 1) {
        vec3 P = collideVertex(vi, rpos(vi));
        float alpha = constraintAlpha();
        for (int e = estart.s[vi]; e < estart.s[vi + 1]; ++e) {
            Entry en = ents.e[e];
            vec3 d = rpos(en.j) - P;
            float dist = length(d);
            if (dist < 1e-6) continue;
            float rest = en.rest * ph.tension;
            P += d * ((dist - rest) / dist * (en.k / (2.0 + alpha)));
        }
        wpos(vi, P);
    } else if (pc.mode == 2) {
        wpos(vi, collideVertex(vi, rpos(vi)));
    } else if (pc.mode == 3) {
        vec3 sum = vec3(0.0);
        for (int t = triStart.s[vi]; t < triStart.s[vi + 1]; ++t) {
            int f = triList.l[t] * 3;
            vec3 pa = rpos(int(tris.t[f]));
            vec3 pb = rpos(int(tris.t[f + 1]));
            vec3 pc = rpos(int(tris.t[f + 2]));
            sum += cross(pb - pa, pc - pa);
        }
        float l = length(sum);
        wnrm(vi, l > 1e-6 ? sum / l : rnrm(vi));
    } else if (pc.mode == 4) {
        wsub0(vi, rpos(vi));
        contactN.n[vi] = vec4(0.0);
        contactL.l[vi] = 0.0;
    } else if (pc.mode == 5) {
        vec3 P = rpos(vi);
        vec3 v = (P - rsub0(vi)) / ph.dt;
        float nl = length(contactN.n[vi].xyz);
        if (nl > 1e-8) {
            vec3 fn = contactN.n[vi].xyz / nl;
            float vn = dot(v, fn);
            if (vn < 0.0)
                v -= fn * vn;
        }
        wprev(vi, P - v * ph.dt);
    }
}