#version 450
// The GPU soft-body sim. ONE general solver: it takes a vertex list + a list of JOINTS
// (two-point distance constraints) and integrates (Verlet) + relaxes the joints + pushes
// out of the Jolt capsules / the ground (one-way). The SAME shader + pipeline steps both
// the cloth and the ball (each with its own vertices + joints) — no pressure, no per-body
// special cases.
//
// RACE-FREE by double-buffering: every position read comes from the READ buffer, every
// position write goes to the OTHER buffer (ping-pong). A thread never reads a slot another
// thread is writing (the live read/write race is what made the first GPU cloth explode).
// `prev` is a separate buffer touched only by its own thread (disjoint per vertex).
//
// One pipeline, four modes (push constant):
//   0 = Verlet    : read pos + prev -> write new pos (other buf), prev = old pos; the
//                   per-substep displacement is clamped to maxStep — a hard anti-divergence
//                   guard so a bad parameter set can never fling a vertex (runaway was the
//                   old explosion mode)
//   1 = relax     : ONE Jacobi pass over this vertex's joints (snapshot reads). NOTE: the
//                   cloth's joint graph is NOT bipartite (each grid cell's diagonal forms a
//                   triangle with its edges), so red-black Gauss-Seidel is impossible here —
//                   Jacobi it is.
//   2 = collide   : push out of capsules + ground, remove normal velocity
//   3 = normals   : recompute the deformed per-vertex normal from the first two joints
//                   (cross of the two joint edges) and write it into .nrm of the CURRENT
//                   buffer. Reads .pos, writes .nrm (disjoint fields) -> race-free, and no
//                   ping-pong flip (it writes to the buffer it reads). The renderer lights
//                   with abs(), so the normal's sign/orientation doesn't matter.
layout(local_size_x = 64) in;

// A render vertex: position + normal + color (48 bytes; std430 -> each vec3 is a 16-byte
// block, so the struct is 3 x 16 = 48 bytes). This is the SAME type the renderer reads to
// draw: the sim steps .pos (Verlet/relax/collide) and recomputes .nrm (mode 3); .col is
// static (set at init, never touched).
struct Vtx { vec3 pos; vec3 nrm; vec3 col; };

layout(binding = 0) buffer PosA { Vtx a[]; } posA;
layout(binding = 1) buffer PosB { Vtx b[]; } posB;
layout(binding = 2) buffer Prev { vec3 v[]; } prevB;

struct Capsule { vec4 centerRadius; vec4 quat; vec4 halfLen; };   // 48 B, mirrors CapsuleGPU
layout(binding = 3) buffer Capsules { Capsule cs[]; } caps;

// Per-vertex relaxation entries: for vertex i, the joints it owns are ents[estart[i] ..
// estart[i+1]); each entry is the joint's OTHER endpoint + rest length + stiffness.
struct Entry { int j; float rest; float k; int pad; };            // 16 B
layout(binding = 4) buffer Entries { Entry e[]; } ents;
layout(binding = 5) buffer EntryStart { int s[]; } estart;        // size n+1

// Shared physics params (std430 flat scalars -> matches the C++ PhysParams exactly).
layout(binding = 6) buffer PhysP {
    int nCaps;
    float dt;
    float damping;
    float gravity;
    float friction;
    float skin;
    float fricMargin;
    float tension;
    float relaxScale;
    float maxStep;
} ph;

// The position at the start of the current sub-step. Friction measures the sub-step's slip
// against this, because the relax pass shifts `prev` with the constraint motion (the energy
// fix), so `pos - prev` no longer contains the tangential slide friction must oppose.
layout(binding = 7) buffer Sub0 { vec3 v[]; } sub0;

layout(push_constant) uniform PC { int mode; int readFromA; int n; int pinned; } pc;

vec3 rpos(int i) { return pc.readFromA != 0 ? posA.a[i].pos : posB.b[i].pos; }
void wpos(int i, vec3 x) { if (pc.readFromA != 0) posB.b[i].pos = x; else posA.a[i].pos = x; }
// The normal field of the CURRENT (read) buffer: written by mode 3 (no flip, so the read
// buffer is the one that holds the live state). Reads .nrm, writes .nrm (disjoint from the
// .pos the other modes touch).
void wnrm(int i, vec3 x) { if (pc.readFromA != 0) posA.a[i].nrm = x; else posB.b[i].nrm = x; }

mat3 quatMat(vec4 q) {
    q = normalize(q);
    float x = q.x, y = q.y, z = q.z, w = q.w;
    return mat3(
        vec3(1.0 - 2.0*(y*y + z*z), 2.0*(x*y + z*w), 2.0*(x*z - y*w)),
        vec3(2.0*(x*y - z*w),       1.0 - 2.0*(x*x + z*z), 2.0*(y*z + x*w)),
        vec3(2.0*(x*z - y*w),       2.0*(y*z - x*w),       1.0 - 2.0*(x*x + z*z)));
}

// The one-way capsule/ground push-out. Multi-pass (like the CPU): in a clumped pile the
// capsules overlap, so pushing a vertex out of one can re-insert it into another — re-check
// against ALL colliders until clean. The loop breaks early once a vertex is clean (most
// vertices: 1 pass); the cap is 64 because the tight drape packs a few vertices into the
// narrow gaps between capsules, where the push-out ping-pongs between adjacent colliders and
// needs many rounds. Per-vertex, so it is safe inside a single (race-free) dispatch.
vec3 pushOut(vec3 P, int passes) {
    for (int pass = 0; pass < passes; ++pass) {
        bool moved = false;
        for (int c = 0; c < ph.nCaps; ++c) {
            vec3 center = caps.cs[c].centerRadius.xyz;
            float radius = caps.cs[c].centerRadius.w;
            vec3 axis = quatMat(caps.cs[c].quat) * vec3(0.0, caps.cs[c].halfLen.x, 0.0);
            vec3 A = center - axis, B = center + axis;
            vec3 AB = B - A;
            float t = clamp(dot(P - A, AB) / max(dot(AB, AB), 1e-6), 0.0, 1.0);
            vec3 Q = A + AB * t;
            vec3 d = P - Q;
            float dist = length(d);
            if (dist < radius + ph.skin) {
                vec3 n = dist > 1e-5 ? d / dist : vec3(0.0, 1.0, 0.0);
                P = Q + n * (radius + ph.skin);
                moved = true;
            }
        }
        if (P.y < 0.0) {
            P.y = 0.0;
            moved = true;
        }
        if (!moved) break;   // nothing moved this pass -> the vertex is clean
    }
    return P;
}

void collideVertex(int i) {
    // Read the current pos + prev, apply the one-way capsule/ground push-out (energy-neutral:
    // shift `prev` with the correction), then apply slip-based friction against the deepest
    // contact in the `fricMargin` band. ALWAYS write the result to the other buffer + prev —
    // the ping-pong needs EVERY slot written each pass.
    vec3 P0 = rpos(i);
    vec3 Pr0 = prevB.v[i];
    vec3 P = pushOut(P0, 64);
    vec3 Pr = Pr0 + (P - P0);

    // the friction contact: the deepest of the capsule band / the ground band
    vec3 fn = vec3(0.0, 1.0, 0.0);
    float fdepth = 0.0;
    for (int c = 0; c < ph.nCaps; ++c) {
        vec3 center = caps.cs[c].centerRadius.xyz;
        float radius = caps.cs[c].centerRadius.w;
        vec3 axis = quatMat(caps.cs[c].quat) * vec3(0.0, caps.cs[c].halfLen.x, 0.0);
        vec3 A = center - axis, B = center + axis;
        vec3 AB = B - A;
        float t = clamp(dot(P - A, AB) / max(dot(AB, AB), 1e-6), 0.0, 1.0);
        vec3 Q = A + AB * t;
        vec3 d = P - Q;
        float dist = length(d);
        float depth = radius + ph.fricMargin - dist;
        if (depth > fdepth) {
            fdepth = depth;
            fn = dist > 1e-5 ? d / dist : vec3(0.0, 1.0, 0.0);
        }
    }
    if (ph.fricMargin - P.y > fdepth) {
        fdepth = ph.fricMargin - P.y;
        fn = vec3(0.0, 1.0, 0.0);
    }
    if (fdepth > 0.0) {
        // the sub-step's tangential slip (after the hard push-out)
        vec3 disp = P - sub0.v[i];
        float dnd = dot(disp, fn);
        vec3 vnd = fn * max(dnd, 0.0);
        vec3 vtd = disp - vnd;

        // a small positional anti-slip correction
        vec3 corr = vtd * (-0.9 * ph.friction);
        float cl = length(corr);
        if (cl > 0.15)
            corr *= 0.15 / cl;
        vec3 Pnew = pushOut(P + corr, 8);

        // remove velocity proportional to the slip (the friction impulse)
        vec3 vel = P0 - Pr0;
        vec3 vKeep = vel - vtd * (1.5 * ph.friction);
        P = Pnew;
        Pr = P - vKeep;
    }
    wpos(i, P);            // ALWAYS write (keeps the ping-pong consistent)
    prevB.v[i] = Pr;
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    if (pc.pinned == 1) return;    // held: frozen at the initial position

    if (pc.mode == 0) {            // Verlet
        vec3 P = rpos(i);
        vec3 Pr = prevB.v[i];
        vec3 d = (P - Pr) * ph.damping + vec3(0.0, ph.gravity, 0.0) * (ph.dt * ph.dt);
        // Stability guard: bound the per-substep displacement. A bad parameter set (low
        // damping + a hard impact) used to feed velocity back through the constraints and
        // diverge; clamping the step makes runaway impossible (a vertex can never travel
        // more than maxStep per sub-step).
        float dl = length(d);
        if (dl > ph.maxStep) d *= ph.maxStep / dl;
        wpos(i, P + d);
        prevB.v[i] = P;
    } else if (pc.mode == 1) {     // one Jacobi relaxation pass over this vertex's joints
        // The projection RESTORES shape; it is not a real velocity change. So after moving the
        // vertex, shift `prev` by the same amount (disjoint per vertex -> race-free). This keeps
        // the implicit Verlet velocity (pos - prev) unchanged by the constraint; otherwise the
        // correction leaks into the velocity and the next Verlet amplifies it (perpetual energy).
        vec3 Pi0 = rpos(i);
        vec3 Pi = Pi0;
        for (int e = estart.s[i]; e < estart.s[i + 1]; ++e) {
            Entry en = ents.e[e];
            vec3 d = rpos(en.j) - Pi;
            float dist = length(d);
            if (dist < 1e-6) continue;
            float rest = en.rest * ph.tension;   // tension scales the rest length (like the CPU)
            Pi += d * ((dist - rest) / dist * 0.5 * en.k * ph.relaxScale);
        }
        wpos(i, Pi);
        prevB.v[i] += Pi - Pi0;
    } else if (pc.mode == 2) {     // collision
        collideVertex(i);
    } else if (pc.mode == 3) {     // recompute the deformed normal from the joints
        // The normal of the triangle (i, j0, j1) formed by the first two joints is a good
        // estimate of the deformed surface normal (it works for the cloth AND the ball).
        // Reads .pos (rpos), writes .nrm (wnrm) — disjoint, so it is race-free and needs no
        // ping-pong flip.
        int s0 = estart.s[i], s1 = estart.s[i + 1];
        if (s1 - s0 >= 2) {
            vec3 P = rpos(i);
            vec3 e1 = rpos(ents.e[s0].j) - P;
            vec3 e2 = rpos(ents.e[s0 + 1].j) - P;
            vec3 n = cross(e1, e2);
            float l = length(n);
            wnrm(i, l > 1e-6 ? n / l : vec3(0.0, 1.0, 0.0));
        }
    } else {                        // mode 4: store the sub-step start position (for friction)
        sub0.v[i] = rpos(i);
    }
}
