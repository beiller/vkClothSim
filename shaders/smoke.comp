#version 450
layout(local_size_x = 64) in;

// vec3 in an SSBO is 16-byte aligned/strided, so the C++ side mirrors this.
struct Capsule { vec3 a; vec3 b; float r; float pad; };

layout(binding = 0) buffer Capsules { Capsule data[]; } caps;
layout(binding = 1) buffer Points   { vec3      data[]; } pts;
layout(binding = 2) buffer Result   { float     data[]; } outd;
layout(binding = 3) uniform Params   { uint n_capsules; uint n_points; } params;

float capsule_sdf(vec3 p, Capsule c) {
    vec3 ab = c.b - c.a;
    vec3 ap = p - c.a;
    float t = clamp(dot(ap, ab) / max(dot(ab, ab), 1e-12), 0.0, 1.0);
    vec3 q = c.a + t * ab;
    return length(p - q) - c.r;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n_points) return;
    float best = 1e30;
    for (uint c = 0; c < params.n_capsules; ++c)
        best = min(best, capsule_sdf(pts.data[i], caps.data[c]));
    outd.data[i] = best;
}
