#version 450
// Godot subsurface_scattering.glsl port: a separable two-pass 1D blur (the host dispatches
// twice: horizontal over the diffuse into temp, vertical composites back into sceneColor).
// Per-channel strength = the ssssWeight side channel (the opaque pass writes the RGB weight
// into the weight attachment, max weight into the diffuse alpha); the blur breaks at alpha
// < 0.001 so the background is never mixed in. The blur acts on the diffuse term only: the
// vertical pass recomposes sceneColor = (scene - originalDiffuse) + blurredDiffuse, so
// specular and transmission stay sharp. 11-sample kernel (6 taps, applied on both sides);
// each color channel walks its own step (its own blur distance), a uniform weight shares
// one sample across channels.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D src; // pass 0: the diffuse; pass 1: temp
layout(r16f, binding = 1) uniform writeonly image2D dst; // pass 0: temp (pass 1: unused, bound to sceneColor)
layout(binding = 2) uniform sampler2D depthTex; // the R32 depth copy (raw 0..1 values)
layout(r16f, binding = 3) uniform image2D sceneImg; // pass 1: sceneColor (own pixel: load then store)
layout(r16f, binding = 4) uniform image2D diffImg; // pass 1: the original diffuse (own pixel)
layout(binding = 5) uniform sampler2D weightTex; // the per-channel ssssWeight (RGB)

layout(push_constant, std430) uniform Params {
    vec2 screenSize;
    float zNear;
    float zFar;
    float unitSize;
    float scale;
    float depthScale;
    bool vertical;
} params;

const int KERNEL_SIZE = 6;
const float kernel[KERNEL_SIZE] = float[](
    0.560479, 0.0771802, 0.0821904, 0.03639, 0.0192831, 0.00471691);
const float kernelDist[KERNEL_SIZE] = float[](
    0.0, 0.08, 0.32, 0.72, 1.28, 2.0);

void do_filter(inout vec3 color, inout float divisor, vec2 uv, vec2 step) {
    for (int i = 1; i < KERNEL_SIZE; ++i) {
        vec4 c = texture(src, uv + kernelDist[i] * step);
        if (abs(c.a) < 0.001)
            break; // mix no more
        color += c.rgb * kernel[i];
        divisor += kernel[i];
    }
}

// per-channel: each color walks its own step (its own blur distance) and cuts on its own
// sample's alpha; a zero-weight channel walks step 0 and returns its input unchanged
void do_filter3(inout vec3 color, inout vec3 div, vec2 uv, vec2 stepR, vec2 stepG, vec2 stepB) {
    for (int i = 1; i < KERNEL_SIZE; ++i) {
        vec4 c = texture(src, uv + kernelDist[i] * stepR);
        if (c.a >= 0.001) {
            color.r += c.r * kernel[i];
            div.r += kernel[i];
        }
        c = texture(src, uv + kernelDist[i] * stepG);
        if (c.a >= 0.001) {
            color.g += c.g * kernel[i];
            div.g += kernel[i];
        }
        c = texture(src, uv + kernelDist[i] * stepB);
        if (c.a >= 0.001) {
            color.b += c.b * kernel[i];
            div.b += kernel[i];
        }
    }
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, ivec2(params.screenSize))))
        return;
    vec2 uv = (vec2(id) + 0.5) / params.screenSize;
    vec4 base = texture(src, uv);
    const vec3 w = texture(weightTex, uv).rgb;
    const float maxW = max(w.x, max(w.y, w.z));
    if (maxW > 0.0) {
        // the engine's GL-convention depth (near = -1, far = 1, cleared to 1) -> linear view distance
        float z = texture(depthTex, uv).r;
        if (z > -1.0) {
            float d = (2.0 * params.zNear * params.zFar) / ((1.0 - z) * params.zFar + (1.0 + z) * params.zNear);
            const float depthScale = params.unitSize / d;
            const float scale = mix(params.scale, depthScale, params.depthScale);
            vec2 dir = params.vertical ? vec2(0.0, 1.0) : vec2(1.0, 0.0);
            const vec2 stepB0 = scale * dir / 3.0;
            vec3 color = base.rgb * kernel[0];
            vec3 div = vec3(kernel[0]);
            if (w.x == w.y && w.y == w.z) { // uniform weight: one sample feeds all channels
                vec2 step = stepB0 * w.x;
                float divisor = div.x;
                do_filter(color, divisor, uv, step);
                do_filter(color, divisor, uv, -step);
                div = vec3(divisor);
            } else {
                do_filter3(color, div, uv, stepB0 * w.x, stepB0 * w.y, stepB0 * w.z);
                do_filter3(color, div, uv, -stepB0 * w.x, -stepB0 * w.y, -stepB0 * w.z);
            }
            base.rgb = vec3(color.r / div.r, color.g / div.g, color.b / div.b);
        }
        // z >= 1.0: background — keep the pass-0 result as-is
        if (params.vertical) {
            // recompose: the sharp part (scene - original diffuse) + the blurred diffuse
            vec4 sc = imageLoad(sceneImg, id);
            vec4 dif = imageLoad(diffImg, id);
            base.rgb = sc.rgb - dif.rgb + base.rgb;
            imageStore(sceneImg, id, base);
        } else {
            imageStore(dst, id, base);
        }
    } else if (!params.vertical) {
        imageStore(dst, id, base);
    }
    // vertical + maxW == 0: sceneColor is left untouched
}
