#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D equirect;
layout(binding = 1, rgba16f) uniform writeonly image2DArray outCube;
layout(push_constant) uniform PC { int size; } pc;

vec3 faceDir(int face, vec2 uv) {
    vec3 d = vec3(uv, 1.0);
    if (face == 0)
        d = vec3(1.0, -uv.y, -uv.x);
    else if (face == 1)
        d = vec3(-1.0, -uv.y, uv.x);
    else if (face == 2)
        d = vec3(uv.x, 1.0, uv.y);
    else if (face == 3)
        d = vec3(uv.x, -1.0, -uv.y);
    else if (face == 4)
        d = vec3(uv.x, -uv.y, 1.0);
    else
        d = vec3(-uv.x, -uv.y, -1.0);
    return normalize(d);
}

vec2 dirToEquirect(vec3 dir) {
    const float PI = 3.14159265359;
    float phi = atan(dir.z, dir.x);
    float theta = asin(clamp(dir.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, 0.5 - theta / PI);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    int face = int(gl_GlobalInvocationID.z);
    if (p.x >= pc.size || p.y >= pc.size)
        return;
    vec2 uv = (2.0 * (vec2(p) + 0.5) / float(pc.size)) - 1.0;
    vec3 dir = faceDir(face, uv);
    imageStore(outCube, ivec3(p.x, p.y, face), vec4(texture(equirect, dirToEquirect(dir)).rgb, 1.0));
}
