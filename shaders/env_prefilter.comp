#version 450
precision highp float;

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform samplerCube env;
layout(binding = 1, rgba16f) uniform writeonly image2DArray outImage;
layout(push_constant) uniform PC { int mip; int size; } pc;

const float TWO_PI = 6.283185307179586;

vec3 faceDir(int face, vec2 uv) {
    vec3 d = vec3(uv, 1.0);
    if (face == 0)
        d = vec3(1.0, -uv.y, -uv.x);
    else if (face == 1)
        d = vec3(-1.0, -uv.y, uv.x);
    else if (face == 2)
        d = vec3(uv.x, 1.0, uv.y);
    else if (face == 3)
        d = vec3(uv.x, -1.0, -uv.y);
    else if (face == 4)
        d = vec3(uv.x, -uv.y, 1.0);
    else
        d = vec3(-uv.x, -uv.y, -1.0);
    return normalize(d);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    int face = int(gl_GlobalInvocationID.z);
    if (pos.x >= pc.size || pos.y >= pc.size)
        return;
    vec2 uv = (2.0 * (vec2(pos) + 0.5) / float(pc.size)) - 1.0;
    vec3 normal = faceDir(face, uv);
    vec3 up = abs(normal.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, normal));
    vec3 B = cross(normal, T);
    float roughness = float(pc.mip) / 4.0;
    float a = roughness;
    float alpha = a * a;
    const int SAMPLES = 4096;
    const int GRID = 64;
    vec3 sum = vec3(0.0);
    for (int i = 0; i < SAMPLES; ++i) {
        vec2 u = (vec2(float(uint(i) % GRID), float(uint(i) / GRID)) + vec2(0.5)) / float(GRID);
        float cosTheta = sqrt((1.0 - u.x) / (u.x * (alpha - 1.0) + 1.0));
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        float phi = TWO_PI * u.y;
        vec3 H = normalize(T * (cos(phi) * sinTheta) + B * (sin(phi) * sinTheta) + normal * cosTheta);
        float NoH = max(dot(normal, H), 0.0);
        vec3 L = normalize(2.0 * NoH * H - normal);
        float NoL = max(dot(normal, L), 0.0);
        if (NoL <= 0.0)
            continue;
        sum += textureLod(env, L, float(pc.mip - 1)).rgb * (0.5 * NoL * NoL);
    }
    sum /= float(SAMPLES);
    imageStore(outImage, ivec3(pos.x, pos.y, face), vec4(sum, 1.0));
}
